{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "Moo",
  "description": "Fast, open and free-to-use new tab page for Firefox.",
  "version": "1.0.0",
  "homepage_url": "https://github.com/apoapostolov/Moo",
  "action": {
    "default_icon": "icons/128x128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/16x16.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "moo@apoapostolov"
    }
  },
  "permissions": ["identity", "storage", "clipboardWrite"],
  "optional_host_permissions": ["*://*/*"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*"
  ]
}
